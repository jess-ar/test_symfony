{% extends 'base.html.twig' %}

{% block body %}
    {% include 'components/back_arrow.html.twig' %}
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="w-full max-w-md p-8 bg-gray-800 rounded-lg shadow-xl">
            <h1 class="mb-6 text-4xl font-bold text-center text-teal-500">¡Regístrate!</h1>

            {{ form_start(registrationForm, {'attr': {'class': 'space-y-6'}}) }}

            <div>
                <label for="email" class="text-lg font-medium text-orange-200/80">Email</label>
                {{ form_widget(registrationForm.email, {
                    'attr': {'class': 'mt-1 block w-full py-2 border-2 border-teal-200 focus:border-gray-600 rounded-md shadow-sm'}
                }) }}
            </div>

            <div>
                <label for="password" class="text-lg font-medium text-orange-200/80">Contraseña</label>
                {{ form_widget(registrationForm.plainPassword, {
                    'attr': {'class': 'mt-1 block w-full py-2 border-2 border-teal-200 focus:border-gray-600 rounded-md shadow-sm'}
                }) }}
            </div>

            <div class="flex items-center">
                <label for="terms" class="ml-2 text-sm text-gray-600">
                    {{ form_widget(registrationForm.agreeTerms, {
                        'attr': {'class': 'border-2 border-teal-200 text-orange-200 focus:border-teal-500'}
                    }) }}
                    Acepto los términos y condiciones
                </label>
            </div>

            <button type="submit" class="w-full px-4 py-3 font-bold text-white transition duration-300 ease-in-out transform bg-teal-800 rounded-full hover:bg-orange-400/80 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50">
                Registrarse
            </button>

            {{ form_end(registrationForm) }}
        </div>
    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block body %}
    {% include 'components/back_arrow.html.twig' %}
    
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="w-full max-w-md p-8 bg-gray-800 rounded-lg shadow-xl">
            <h1 class="mb-6 text-4xl font-bold text-center text-teal-500">Editar Post</h1>

            {{ form_start(form, {'attr': {'class': 'space-y-6', 'data-turbo': 'false'}}) }}
                {{ form_row(form._token) }}
            <div>
                <label for="title" class="text-lg font-medium text-orange-200/80">Título</label>
                {{ form_widget(form.title, {
                    'attr': {'class': 'mt-1 block w-full py-2 border-2 border-teal-200 focus:border-gray-600 rounded-md shadow-sm'}
                }) }}
            </div>

            <div>
                <label for="description" class="text-lg font-medium text-orange-200/80">Descripción</label>
                {{ form_widget(form.description, {
                    'attr': {'class': 'mt-1 block w-full py-2 border-2 border-teal-200 focus:border-gray-600 rounded-md shadow-sm'}
                }) }}
            </div>

            <div>
                <label for="image" class="text-lg font-medium text-orange-200/80">Imagen</label>
                {{ form_widget(form.image, {
                    'attr': {'class': 'mt-1 block w-full py-2 border-2 border-teal-200 focus:border-gray-600 rounded-md shadow-sm'}
                }) }}
            </div>

            {% if post.image %}
            <div class="mb-4 text-center">
            <img src="{{ absolute_url(asset('uploads/' ~ post.image)) }}" alt="Imagen actual" class="max-w-[200px] max-h-[200px] mx-auto border-2 border-teal-200 rounded-lg shadow-md">
            </div>
            {% endif %}


            <button type="submit" class="w-full px-4 py-3 font-bold text-white transition duration-300 ease-in-out transform bg-teal-800 rounded-full hover:bg-orange-400/80 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50">
                Guardar Cambios
            </button>

        </div>
    </div>
{% endblock %}
<div class="max-w-sm gap-6 p-6 mx-auto bg-gray-800 rounded-lg shadow-lg hover:scale-105">
    <h3 class="p-8 text-2xl font-semibold text-center text-teal-500">{{ post.title }}</h3>

    <div class="flex items-center justify-center p-6 overflow-hidden bg-gray-900 rounded-lg">
    <img class="object-contain max-w-[150px] max-h-[150px]" 
        src="{{ asset('uploads/' ~ post.image) }}" 
        alt="{{ post.title }}">
</div>


    <p class="p-4 text-xs leading-tight text-center text-teal-100 sm:text-sm md:text-base line-clamp-2">
        {{ post.description }}
    </p>

    <div class="flex justify-center w-full gap-2">
        <a href="{{ path('post_edit', {'id': post.id}) }}" 
            class="px-6 py-3 mb-6 text-xs font-bold text-white bg-yellow-500 rounded-full hover:bg-yellow-600">
            Editar
        </a>
        <a href="{{ path('post_delete', {'id': post.id}) }}" 
            class="px-6 py-3 mb-6 text-xs font-bold text-white bg-red-500 rounded-full hover:bg-red-600"
            onclick="return confirm('¿Estás seguro de que deseas eliminar este post?');">
            Eliminar
        </a>
    </div>
</div>